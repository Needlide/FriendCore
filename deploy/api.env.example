# FriendCore API runtime configuration — TEMPLATE.
#
# Copy to ~/.config/friendcore/api.env, fill in, then: chmod 600
# It is deliberately NOT in the repository: everything here is either a secret
# or an environment-specific value that would be wrong on another host.
#
#   install -Dm600 deploy/api.env.example ~/.config/friendcore/api.env
#
# Keys use .NET's double-underscore separator, so Storage__Endpoint here is the
# "Storage:Endpoint" that appsettings.json and Program.cs read.

# --- Host -----------------------------------------------------------------
# Production is required for anything reachable from the internet. It enables
# HSTS, disables the dev OpenAPI endpoint, and surfaces the missing-config
# warnings that Development suppresses.
ASPNETCORE_ENVIRONMENT=Production

# 0.0.0.0 so Caddy can reach it. NOT 127.0.0.1 — that would only accept loopback.
ASPNETCORE_URLS=http://0.0.0.0:5024

# Directory served as the SPA. Relative paths resolve against the API project
# directory, so an absolute path is less surprising.
Spa__Path=/home/YOU/Documents/FriendCore/FriendCoreClient/dist/friendcore-client/browser

# --- Reverse proxy --------------------------------------------------------
# The address Caddy connects FROM. Without this the API ignores X-Forwarded-*
# and sees every tester as the proxy itself: one shared rate-limit bucket, an
# admin allowlist checking the wrong address, and audit logs full of one IP.
# For the thin-client ingress that is 10.7.0.1 (its WireGuard address).
ForwardedHeaders__KnownProxies=10.7.0.1

Cors__AllowedOrigins__0=https://beta.example.com
Cors__AllowedOrigins__1=http://localhost:3000

# --- Admin surface --------------------------------------------------------
# /api/v1/admin is 404 for any address not listed. The middleware enforces this
# whenever these lists are non-empty, in every environment — empty lists mean
# no restriction at all, not "restricted in dev only".
# Add your home public IP, and 10.0.0.0/8 to allow admin over the WireGuard
# tunnel regardless of source address.
AdminAccess__AllowedIps__0=203.0.113.10
AdminAccess__AllowedNetworks__0=10.0.0.0/8

# Email addresses granted the admin role at seeding. Without at least one of
# these, no account has admin and the dashboard is unreachable.
Seeding__AdminEmails__0=you@example.com

# --- Storage (RustFS / S3) ------------------------------------------------
# appsettings.json ships these EMPTY; real values exist only in the Development
# file. Starting Production without them breaks every media upload, quietly.
Storage__Endpoint=http://localhost:9000
Storage__AccessKey=CHANGE_ME
Storage__SecretKey=CHANGE_ME
Storage__Bucket=friendcore-media
Storage__EnsureBucketExists=true

# Base for publicly reachable media URLs. Leave empty when the bucket is private
# and media is served through presigned URLs instead.
Storage__PublicBaseUrl=https://beta.example.com

# --- Security -------------------------------------------------------------
# MUST be at least 32 characters or the API throws at startup. Rotating this
# invalidates every issued token, so everyone must sign in again.
Jwt__SecretKey=CHANGE_ME_at_least_32_characters_long_random

# --- Email ----------------------------------------------------------------
# Verification links point here; localhost here means users get unusable links.
Email__VerificationBaseUrl=https://beta.example.com
# Leave empty to skip sending. Registration works without it in this setup.
Email__ResendApiKey=