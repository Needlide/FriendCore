# FriendCore — local development environment template.
#
# Copy to `.env` (gitignored) and adjust as needed:  cp .env.example .env
#
# WHAT BELONGS WHERE
#   - This file / .env  -> non-secret service config + LOCAL-ONLY dev credentials that
#                          docker-compose.dev.yml consumes (Postgres, Redis, MinIO).
#   - dotnet user-secrets -> real app secrets the API reads (e.g. Jwt:SecretKey, Resend API key,
#                          and in production the R2 keys). These never go in any committed file.
#                          Set with:  dotnet user-secrets set "Jwt:SecretKey" "<value>"
#   - appsettings*.json -> non-secret defaults only.
#
# Env vars override appsettings via the standard .NET precedence; nested keys use a double
# underscore, e.g. Storage__Endpoint maps to the "Storage:Endpoint" config key.

# --- PostgreSQL (docker-compose.dev.yml) ---
POSTGRES_USER=friendcore
POSTGRES_PASSWORD=friendcore
POSTGRES_DB=friendcore

# --- Redis (docker-compose.dev.yml) ---
# No credentials in dev; listed for completeness.
REDIS_PORT=6379

# --- MinIO / object storage (added with the Media slice — Step 3) ---
# S3-compatible local stand-in for Cloudflare R2. The API talks to it through the same
# S3StorageService it will use against R2 in production; only these values change per environment.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=friendcore-media

# Storage config the API reads (Storage section). In dev these point at local MinIO; in prod they
# point at R2 and the access keys live in the platform secret store, not here.
Storage__Endpoint=http://localhost:9000
Storage__Bucket=friendcore-media
Storage__AccessKey=minioadmin
Storage__SecretKey=minioadmin
Storage__UsePathStyle=true
