@HostAddress = http://localhost:5024

GET {{HostAddress}}/
Accept: application/json

###

GET {{HostAddress}}/health
Accept: application/json

###

POST {{HostAddress}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "needlide",
  "displayName": "Needlide",
  "email": "dev@friendcore.local",
  "password": "ChangeMe123!"
}

###

# @name login
POST {{HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "dev@friendcore.local",
  "password": "ChangeMe123!"
}

###

@token = {{login.response.body.accessToken}}

###

GET {{HostAddress}}/api/v1/users/needlide
Accept: application/json

###

PATCH {{HostAddress}}/api/v1/users/me/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "bio": "Building FriendCore.",
  "location": "Ukraine"
}

###

POST {{HostAddress}}/api/v1/auth/verify-email
Content-Type: application/json

{
  "token": "PASTE_TOKEN_FROM_LOGS"
}

###

POST {{HostAddress}}/api/v1/auth/resend-verification
Authorization: Bearer {{token}}

###
