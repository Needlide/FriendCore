{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=friendcore;Username=friendcore;Password=friendcore",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "FriendCore",
    "Audience": "FriendCore",
    "SecretKey": "DEV_ONLY_CHANGE_ME_use_user_secrets_in_development_32chars",
    "AccessTokenExpirationMinutes": 60
  },
  "Sentry": {
    "Dsn": "",
    "TracesSampleRate": 0.0
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}      {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "FriendCore.API"
    }
  },
  "AllowedHosts": "*"
}
