<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FriendCore.Application\FriendCore.Application.csproj" />
        <ProjectReference Include="..\FriendCore.Domain\FriendCore.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
        <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
        <PackageReference Include="AWSSDK.S3" Version="4.0.24.3" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.6" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.6" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.6">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
        <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
        <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    </ItemGroup>

    <!--
      Three ImageSharp advisories are suppressed by URL rather than by a blanket
      NoWarn, so a genuinely new advisory still fails the build. Re-check when
      the package is next upgraded: 4.x fixes all three but requires a paid Six
      Labors license, and 3.2.0 fixes none of them.

      None of the three is reachable from FriendCore:

        GHSA-j3p4-wp97-rph4  HistogramEqualization trusts an unvalidated
                             luminance value. FriendCore never calls it; the only
                             mutation applied is AutoOrient (ProcessMediaJob).

        GHSA-j9gm-c75j-xc9q  TIFF CCITT T4 encoder writes past its output
                             buffer. TIFF is not an accepted upload: only
                             jpeg/png/webp/gif are (ImageContentTypes.cs), and
                             uploads are validated against magic bytes rather
                             than trusting the declared content type.

        GHSA-jjfr-hcj7-qf5w  TIFF CCITT T6 encoder — same reachability argument
                             as the T4 advisory.
    -->
    <ItemGroup>
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    </ItemGroup>

    <ItemGroup>
        <!-- Same precedent as FriendCore.Application: the channel's bounding behaviour (does it
             block, drop, or grow when full?) is the whole point of the change and is not reachable
             through IMediaProcessingQueue. -->
        <InternalsVisibleTo Include="FriendCore.UnitTests"/>
    </ItemGroup>

</Project>
